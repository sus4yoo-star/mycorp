# ---- Supabase (server + client) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI providers (server only) ----
# Claude is the default provider. See packages/ai-gateway.
ANTHROPIC_API_KEY=
MYCORP24_AI_PROVIDER=anthropic

# ---- Credential vault (spec §110, §187) ----
# 32-byte key, base64. Encrypts stored OAuth/refresh tokens at rest.
MYCORP24_CREDENTIAL_KEY=

# ---- OAuth clients (server only) ----
# Google: console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://<host>/api/oauth/GMAIL/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Meta: developers.facebook.com → App → Facebook Login
# Authorized redirect URI: https://<host>/api/oauth/INSTAGRAM/callback
META_OAUTH_CLIENT_ID=
META_OAUTH_CLIENT_SECRET=

# ---- Scheduled intelligence (server only) ----
# Shared secret between the scheduler and /api/intelligence/collect.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MYCORP24_CRON_SECRET=
